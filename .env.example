DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=storms
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false
# Paste the TiDB CA PEM certificate as a multiline value in production.
DATABASE_CA=

# TiDB Cloud Vercel integration can provide TIDB_HOST, TIDB_PORT,
# TIDB_DATABASE, TIDB_USER and TIDB_PASSWORD instead of DATABASE_*.
# Public TiDB endpoints require TLS.
TIDB_ENABLE_SSL=false
TIDB_CA=

# Generate with: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate a long random value (at least 32 characters)
SESSION_SECRET=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=12
